# Copy to .env and adjust. Contains NO real secrets; never commit a populated .env.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYMENT_FILE=../../deployments/31337.json
DATABASE_PATH=./data/vectra.db
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=8787
# >= 24 chars. Leave empty to disable admin endpoints. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
# Only set true behind a proxy you control (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=false
HEALTH_MAX_LAG_BLOCKS=50

# Indexer
CONFIRMATIONS=2
INDEXER_POLL_MS=4000
INDEXER_BATCH_BLOCKS=2000
REORG_WINDOW_BLOCKS=256
SNAPSHOT_INTERVAL_MS=60000

# Keeper. Without KEEPER_PRIVATE_KEY the keeper runs in dry-run mode (simulate + log only).
# The key must hold ONLY the vault KEEPER role. Inject via a secret manager in production.
KEEPER_PRIVATE_KEY=
KEEPER_POLL_MS=30000
KEEPER_MAX_FEE_PER_GAS_WEI=100000000000
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
LEASE_TTL_MS=120000
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=900000

# Keeper policy
KEEPER_ENABLE_PROCESS=true
KEEPER_ENABLE_REBALANCE=true
KEEPER_ENABLE_DRIFT=false
KEEPER_ENABLE_EXPIRE=true
DRIFT_THRESHOLD_BPS=500
REBALANCE_THRESHOLD_BPS=100
PROCESS_MAX_REQUESTS=25
REBALANCE_MAX_ACTIONS=8
KEEPER_MAX_ACTIONS_PER_INDEX_TICK=4
QUEUE_AGE_ALERT_SECONDS=86400
