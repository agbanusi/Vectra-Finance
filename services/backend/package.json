{
  "name": "@vectra/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/cli/migrate.ts",
    "rebuild": "tsx src/cli/rebuild.ts",
    "start:api": "tsx src/cli/api.ts",
    "start:indexer": "tsx src/cli/indexer.ts",
    "start:keeper": "tsx src/cli/keeper.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@vectra/sdk": "workspace:*",
    "hono": "4.13.13",
    "tsx": "4.23.15",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
