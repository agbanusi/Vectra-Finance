# Chain the dApp talks to. Default: Sepolia (11155111). Use 31337 for the local anvil demo (mock assets).
NEXT_PUBLIC_CHAIN_ID=11155111
# JSON-RPC URL. Defaults: Sepolia -> https://ethereum-sepolia-rpc.publicnode.com, 31337 -> http://127.0.0.1:8545.
# publicnode keeps only ~1.5 days of historical state; an archive RPC gives longer APY windows and charts.
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Core addresses. For chains 11155111 and 31337 these fall back to the bundled deployments/<chainId>.json when unset.
NEXT_PUBLIC_FACTORY=
NEXT_PUBLIC_LENS=
# Block explorer base URL (no trailing slash). Defaults to https://sepolia.etherscan.io on Sepolia.
NEXT_PUBLIC_EXPLORER_URL=
# Optional enrichment API (services/backend): NAV snapshots, activity, metadata. Leave empty to read everything from chain.
NEXT_PUBLIC_API_URL=
# Optional. Enables WalletConnect in the wallet modal (requires @walletconnect/ethereum-provider).
NEXT_PUBLIC_WC_PROJECT_ID=
