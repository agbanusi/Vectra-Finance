# Chain the dApp talks to. 31337 = local anvil demo (mock assets).
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Core addresses. For chain 31337 these fall back to deployments/31337.json when unset.
NEXT_PUBLIC_FACTORY=
NEXT_PUBLIC_LENS=
# Optional block explorer base URL (no trailing slash), e.g. https://etherscan.io
NEXT_PUBLIC_EXPLORER_URL=
# Optional enrichment API (NAV history, activity, keeper status). The app works without it.
NEXT_PUBLIC_API_URL=http://localhost:8787
# Optional. WalletConnect is enabled only when set (requires @walletconnect/ethereum-provider).
NEXT_PUBLIC_WC_PROJECT_ID=
